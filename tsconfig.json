{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "exclude": ["artifacts", "bin", "build", "coverage", "dist", "node_modules", "obj"]
}
