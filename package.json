{
  "name": "@renovatebot/pgp",
  "version": "0.0.0-semantic-release",
  "description": "PGP library for renovate",
  "keywords": [
    "pgp",
    "renovate"
  ],
  "license": "Apache-2.0",
  "author": "Michael Kriese <michael.kriese@gmx.de>",
  "repository": {
    "type": "git",
    "url": "https://github.com/renovatebot/pgp.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "index.d.ts",
    "dist/"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "run-p -l 'build:*'",
    "build:dotnet": "dotnet publish dotnet && node tools/patch-build.js",
    "build:java": "./gradlew build",
    "debug:teavm-wasm": "node --inspect-brk test/teavm/wasm.js",
    "prepare": "husky",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "test": "vitest run",
    "test:teavm-wasm": "node test/teavm/wasm.js",
    "test:teavm-wasm:prof": "node --prof test/teavm/wasm.js"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.0.5",
    "@containerbase/semantic-release-pnpm": "1.4.4",
    "@renovatebot/kbpgp": "4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "npm-run-all2": "9.0.4",
    "openpgp": "6.3.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.7"
}
